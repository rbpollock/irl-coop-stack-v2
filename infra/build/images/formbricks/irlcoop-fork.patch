@@ -12,7 +13,35 @@ import { getProxySession } from "@/modules/auth/lib/proxy-session";
 const handleAuth = async (request: NextRequest): Promise<NextResponse | null> => {
   const session = await getProxySession(request);
 
-  if (isAuthProtectedRoute(request.nextUrl.pathname) && !session) {
+  // irl.coop: the bare root "/" must also auto-login. The / page (page.tsx) redirects
+  // to /auth/login when there's no session, but isAuthProtectedRoute only lists
+  // /environments, /setup/organization, /organizations — so without this, a gated
+  // user with an existing org lands on the native login form instead of SSO.
+  const needsAuth =
+    isAuthProtectedRoute(request.nextUrl.pathname) || request.nextUrl.pathname === "/";
+
+  // irl.coop Gate-SSO fires for ANY app page, not only the `needsAuth` routes above.
+  // Deep links (/workspaces/<id>/surveys/templates) are not in the upstream protected
+  // list, so without this a member following one got the native login form instead of
+  // auto-login. Deliberately excluded: /auth/* (the login page itself must render),
+  // /api/* (including the gate-sso endpoint — redirecting to it would loop), and the
+  // public survey domain (respondents stay anonymous there).
+  const pathname = request.nextUrl.pathname;
+  const isAppPage = !pathname.startsWith("/auth/") && !pathname.startsWith("/api/");
+  const gateEmail = request.headers.get("x-forwarded-email");
+
+  if (
+    !session &&
+    isAppPage &&
+    env.GATE_SSO_ENABLED === "1" &&
+    gateEmail &&
+    !isRequestFromPublicDomain(request)
+  ) {
+    const gateUrl = `${WEBAPP_URL}/api/auth/gate-sso?callbackUrl=${encodeURIComponent(WEBAPP_URL + pathname + request.nextUrl.search)}`;
+    return NextResponse.redirect(gateUrl);
+  }
+
+  if (needsAuth && !session) {
     const loginUrl = `${WEBAPP_URL}/auth/login?callbackUrl=${encodeURIComponent(WEBAPP_URL + request.nextUrl.pathname + request.nextUrl.search)}`;
     return NextResponse.redirect(loginUrl);
   }
