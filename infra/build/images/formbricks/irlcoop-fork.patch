@@ -0,0 +1,65 @@
+/**
+ * irl.coop default workspace skin.
+ *
+ * Applied when a coop group's workspace is created (and to any pre-existing
+ * workspace whose styling/head scripts are empty) in the gate-SSO provisioning
+ * path, so every group is born irl.coop-styled instead of needing a manual apply.
+ *
+ * Scope: our own file (added by irlcoop-fork.patch) — no upstream file is touched
+ * for the skin itself; the tokens are the same ones documented in
+ * docs/design/formbricks-customization-scope.md §5/§6c.
+ */
+
+/** Self-hosted serif (SIL OFL-1.1) in our own MinIO public-assets bucket. */
+const IRLCOOP_FONT_URL =
+  process.env.IRLCOOP_FONT_URL ??
+  "https://s3api.irl.coop/public-assets/fonts/cormorant-garamond-600-latin.woff2";
+
+export const IRLCOOP_WORKSPACE_STYLING = {
+  allowStyleOverwrite: true,
+  brandColor: { light: "#7C3AED" },
+  accentBgColor: { light: "#F5F3FF" },
+  accentBgColorSelected: { light: "#7C3AED" },
+  footerLinkColor: { light: "#7C3AED" },
+  buttonBgColor: { light: "#7C3AED" },
+  buttonTextColor: { light: "#FFFFFF" },
+  buttonBorderRadius: "12px",
+  buttonHeight: "44px",
+  buttonFontSize: "14px",
+  buttonFontWeight: "600",
+  inputBgColor: { light: "#FFFFFF" },
+  inputBorderColor: { light: "#E9D5FF" },
+  inputBorderRadius: "12px",
+  inputTextColor: { light: "#4C1D95" },
+  optionBgColor: { light: "#FFFFFF" },
+  optionLabelColor: { light: "#4C1D95" },
+  optionBorderColor: { light: "#E9D5FF" },
+  optionBorderRadius: "12px",
+  elementHeadlineColor: { light: "#4C1D95" },
+  elementDescriptionColor: { light: "#475569" },
+  cardBackgroundColor: { light: "#FFFFFF" },
+  cardBorderColor: { light: "#E9D5FF" },
+  highlightBorderColor: { light: "#7C3AED" },
+  progressTrackBgColor: { light: "#EDE9FE" },
+  progressIndicatorBgColor: { light: "#16A34A" },
+  roundness: 12,
+  isDarkModeEnabled: false,
+  background: { bg: "#FAF5FF", bgType: "color", brightness: 100 },
+};
+
+/**
+ * Workspace-level custom head scripts apply to every link survey in the
+ * workspace. `fontFamily` is not mapped by the survey renderer in 5.4.0, so the
+ * serif is delivered here (see the scope doc §6c).
+ */
+export const IRLCOOP_WORKSPACE_HEAD_SCRIPTS = `<style>
+@font-face {
+  font-family: "Cormorant Garamond";
+  src: url("${IRLCOOP_FONT_URL}") format("woff2");
+  font-weight: 600; font-style: normal; font-display: swap;
+}
+h1, h2, h3, h4, [class*="headline"], [class*="Headline"] {
+  font-family: "Cormorant Garamond", Georgia, "Times New Roman", serif !important;
+  letter-spacing: 0.01em;
+}
+</style>`;
