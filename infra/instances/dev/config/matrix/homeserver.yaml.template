# Synapse homeserver config — irl.coop private chat (federation disabled).
# Generated for the dev instance; secrets live here (gitignored).
server_name: "matrix.irl.coop"
public_baseurl: "https://matrix.irl.coop"
# /.well-known/matrix/client is built dynamically — serve it and add the
# MatrixRTC rtc_foci (the LiveKit SFU) for Cinny/Element Call group calls.
serve_client_wellknown: true
serve_server_wellknown: true
extra_well_known_client_content:
  org.matrix.msc4143.rtc_foci:
    - type: livekit
      livekit_service_url: "https://rtc.irl.coop"
pid_file: /data/homeserver.pid
report_stats: false
# signing key generated at first start — /config is mounted read-only
signing_key_path: /data/matrix.irl.coop.signing.key

listeners:
  - port: 8008
    type: http
    x_forwarded: true
    bind_addresses: ["0.0.0.0"]
    resources:
      - names: [client]
        compress: true
      # Serve ONLY the federation "openid" servlet group (REQUIRE_AUTH=false),
      # which is /_matrix/federation/v1/openid/userinfo — the endpoint lk-jwt
      # uses to validate Matrix OpenID tokens. Real federation stays off (no
      # federation servlet group here + federation_domain_whitelist: [] below).
      - names: [openid]
        compress: false
# No federation listener (8448): inbound federation is off by construction.
# serve_server_wellknown redirects federation traffic to :443 → this listener
# via the edge (Traefik TLS), which is how lk-jwt-service reaches it.

database:
  name: psycopg2
  args:
    user: matrix
    password: "${SYNAPSE_POSTGRES_PASSWORD}"
    database: matrix
    host: 172.17.0.1
    port: 5432

media_store_path: /data/media_store

enable_registration: false
enable_registration_without_verification: false
enable_room_list_search: true
# Allow any member to send the group-call membership state event (Cinny gates
# the call button on it, and it otherwise defaults to state_default=50, which
# only moderators/creators have). Power level 0 = every member can call.
default_power_level_content_override:
  private_chat:
    events:
      "org.matrix.msc3401.call.member": 0
  trusted_private_chat:
    events:
      "org.matrix.msc3401.call.member": 0
  public_chat:
    events:
      "org.matrix.msc3401.call.member": 0
trusted_key_servers: []
federation_domain_whitelist: []
url_preview_enabled: false

# coop-api appservice: metadata observer feeding the notification bus
# (docs/design/matrix-chat-and-notifications.md). Rendered at runtime.
app_service_config_files:
  - /data/coop-api-registration.yaml

# OIDC — the realm's `matrix` client. Localpart derives from the EMAIL claim
# (the canonical @irl.coop), never the preferred_username — the Google broker
# usernames contain '@' and would poison the localpart (the stalwart lesson).
oidc_providers:
  - idp_id: coop-gateway
    idp_name: "irl.coop"
    # the fleet session gateway — authorize answers instantly from the
    # coop_session cookie (no Keycloak page when the dashboard session exists)
    issuer: "https://api.irl.coop"
    client_id: "matrix"
    client_secret: "${SYNAPSE_OIDC_CLIENT_SECRET}"
    scopes: ["openid", "profile", "email"]
    user_mapping_provider:
      config:
        subject_claim: "sub"
        localpart_template: "{{ user.email.split('@')[0] }}"
        display_name_template: "{{ user.name }}"
        email_template: "{{ user.email }}"
    discover: true

# Media on the shared MinIO (bucket matrix-media, user matrix-s3).
media_storage_providers:
  - module: s3_storage_provider.S3StorageProviderBackend
    store_local: true
    store_synchronous: true
    store_remote: true
    config:
      bucket: matrix-media
      endpoint_url: http://172.17.0.1:9000
      access_key_id: matrix-s3
      secret_access_key: "${SYNAPSE_MEDIA_S3_SECRET}"
      region_name: us-east-1

# TURN for Element Call (coturn, same pillar). REST-auth secret shared.
turn_uris:
  - "turn:64.135.141.73:3478?transport=udp"
  - "turn:64.135.141.73:3478?transport=tcp"
turn_shared_secret: "${SYNAPSE_TURN_SHARED_SECRET}"
turn_user_lifetime: 86400000
turn_allow_guests: false
