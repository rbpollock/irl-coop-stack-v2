+++ b/backend/app/Services/Domain/Coop/CoopEventBusWebhookProvisioner.php
@@ -0,0 +1,139 @@
+<?php
+
+declare(strict_types=1);
+
+namespace HiEvents\Services\Domain\Coop;
+
+use HiEvents\DomainObjects\Status\WebhookStatus;
+use HiEvents\Models\Account;
+use HiEvents\Models\Event;
+use HiEvents\Models\Webhook;
+use Illuminate\Config\Repository;
+use Psr\Log\LoggerInterface;
+
+/**
+ * Hi.Events → the coop EVENT BUS.
+ *
+ * Every ticketing event in a workspace gets a webhook pointed at the coop bus, so
+ * sales, attendees and check-ins land on the group's stream without anyone
+ * clicking through the webhook UI. The workspace decides the TARGET by baking it
+ * into the URL the (single, shared) bus endpoint is called with:
+ *
+ *   ?group=<slug>   a coop group workspace → the GROUP's stream, so every member
+ *                   sees the group's own activity
+ *   ?owner=<email>  a personal workspace  → that member's personal stream
+ *
+ * The target comes from `accounts.external_ref` (coop:<slug> / personal:user:<id>),
+ * the same key the group-workspace provisioning uses, so it survives renames of
+ * the Hi.Events account itself.
+ *
+ * Idempotent and self-healing: `ensureForEvent()` creates the row when missing,
+ * refreshes the subscribed types, and deletes rows pointing at a stale target
+ * (e.g. after a workspace changed group). Nothing happens at all unless
+ * COOP_EVENT_BUS_URL is configured, so a non-coop deployment of this fork is
+ * unaffected.
+ */
+class CoopEventBusWebhookProvisioner
+{
+    public function __construct(
+        private readonly Repository      $config,
+        private readonly LoggerInterface $logger,
+    ) {}
+
+    public function enabled(): bool
+    {
+        return trim((string) $this->config->get('app.coop_event_bus_url')) !== '';
+    }
+
+    /** The Hi.Events event types the coop subscribes to. */
+    public function eventTypes(): array
+    {
+        $configured = (string) $this->config->get('app.coop_event_bus_events', '');
+
+        return array_values(array_filter(array_map('trim', explode(',', $configured))));
+    }
+
+    public function ensureForEvent(Event $event): ?Webhook
+    {
+        if (!$this->enabled()) {
+            return null;
+        }
+
+        $url = $this->urlFor($event);
+
+        if ($url === null) {
+            return null;
+        }
+
+        // Drop rows for this event that point at another (stale) target.
+        Webhook::query()
+            ->where('event_id', $event->id)
+            ->where('url', '!=', $url)
+            ->where('url', 'like', rtrim((string) $this->config->get('app.coop_event_bus_url'), '/').'%')
+            ->whereNull('deleted_at')
+            ->delete();
+
+        $existing = Webhook::query()
+            ->where('event_id', $event->id)
+            ->where('url', $url)
+            ->whereNull('deleted_at')
+            ->first();
+
+        if ($existing !== null) {
+            // Keep the subscription + state fresh without touching anything else.
+            $existing->event_types = $this->eventTypes();
+            $existing->status = WebhookStatus::ENABLED->name;
+            $existing->save();
+
+            return $existing;
+        }
+
+        $this->logger->info('Provisioning a coop event-bus webhook', [
+            'event_id' => $event->id,
+            'account_id' => $event->account_id,
+        ]);
+
+        return Webhook::query()->create([
+            'url' => $url,
+            'event_types' => $this->eventTypes(),
+            'status' => WebhookStatus::ENABLED->name,
+            'secret' => (string) $this->config->get('app.coop_event_bus_secret'),
+            'user_id' => $event->user_id,
+            'event_id' => $event->id,
+            'account_id' => $event->account_id,
+        ]);
+    }
+
+    /** Forget the bus webhook for an event (used when a workspace loses its group). */
+    public function forgetForEvent(Event $event): void
+    {
+        Webhook::query()
+            ->where('event_id', $event->id)
+            ->where('url', 'like', rtrim((string) $this->config->get('app.coop_event_bus_url'), '/').'%')
+            ->whereNull('deleted_at')
+            ->delete();
+    }
+
+    private function urlFor(Event $event): ?string
+    {
+        $account = Account::query()->find($event->account_id);
+
+        if ($account === null) {
+            return null;
+        }
+
+        $ref = trim((string) $account->external_ref);
+
+        if (str_starts_with($ref, 'coop:')) {
+            $target = 'group='.rawurlencode(substr($ref, strlen('coop:')));
+        } elseif (trim((string) $account->email) !== '') {
+            $target = 'owner='.rawurlencode(strtolower((string) $account->email));
+        } else {
+            return null;
+        }
+
+        $base = trim((string) $this->config->get('app.coop_event_bus_url'));
+
+        return $base.(str_contains($base, '?') ? '&' : '?').$target;
+    }
+}
diff --git a/backend/app/Services/Domain/Coop/CoopWorkspaceProvisioner.php b/backend/app/Services/Domain/Coop/CoopWorkspaceProvisioner.php
new file mode 100644
index 00000000..4c06c820
--- /dev/null
+++ b/backend/app/Services/Domain/Coop/CoopWorkspaceProvisioner.php
@@ -0,0 +1,248 @@
+<?php
+
+declare(strict_types=1);
+
+namespace HiEvents\Services\Domain\Coop;
+
+use HiEvents\DomainObjects\Enums\Role;
+use HiEvents\DomainObjects\Status\OrganizerStatus;
+use HiEvents\DomainObjects\Status\UserStatus;
+use HiEvents\DomainObjects\UserDomainObject;
+use HiEvents\Helper\IdHelper;
+use HiEvents\Models\Account;
+use HiEvents\Models\AccountConfiguration;
+use HiEvents\Models\Organizer;
+use HiEvents\Repository\Interfaces\AccountUserRepositoryInterface;
+use HiEvents\Repository\Interfaces\OrganizerRepositoryInterface;
+use HiEvents\Services\Domain\Account\AccountUserAssociationService;
+use HiEvents\Services\Domain\Organizer\CreateDefaultOrganizerSettingsService;
+use Illuminate\Config\Repository;
+use Psr\Log\LoggerInterface;
+use Throwable;
+
+/**
+ * irl.coop group workspaces — ONE Hi.Events ACCOUNT PER COOP GROUP.
+ *
+ * Hi.Events' tenant boundary is the account (events, organizers, users, tax and
+ * billing settings all hang off `account_id`), so a coop group maps onto an
+ * account and the member's group seats become memberships in it. The input is the
+ * coop `groups` claim — minted by coop-api as a JSON STRING and forwarded by the
+ * oauth2-proxy gate as `x-forwarded-groups`. The group is the source of truth, so
+ * every sign-in converges:
+ *
+ *   - account       keyed by `external_ref = coop:<slug>` (rename-safe)
+ *   - account name  synced to the group name
+ *   - membership    role mapped from the coop seat roles (see the tier map)
+ *   - organizer     one public-facing organizer per group, created LIVE
+ *
+ * Nothing here throws out to the caller: a provisioning failure is logged and the
+ * member still signs in (the rule the Formbricks gate-SSO port also follows).
+ *
+ * Accounts are read/written through the Eloquent model rather than the repository
+ * — `external_ref` is an irl.coop column and the generated DomainObjects are code
+ * generated upstream, so the coop layer stays out of them.
+ */
+class CoopWorkspaceProvisioner
+{
+    /**
+     * THE TIER MAP — which coop seat role buys which Hi.Events tier.
+     *
+     * Hi.Events has two useful account tiers: ADMIN (events, users, settings,
+     * billing) and ORGANIZER (runs events, no account admin). The group controls
+     * the tiering by assigning coop roles; this map is the one place to change it.
+     * FOLLOW-ON: per-group overrides carried in the claim (a group marks someone a
+     * workspace admin independently of their seat role), which needs a
+     * group-settings column on the coop side.
+     */
+    private const ROLE_TO_ACCOUNT_ROLE = [
+        'owner' => Role::ADMIN->value,
+        'member' => Role::ADMIN->value,
+    ];
+
+    private const DEFAULT_ACCOUNT_ROLE = Role::ORGANIZER->value;
+
+    public function __construct(
+        private readonly AccountUserRepositoryInterface        $accountUserRepository,
+        private readonly OrganizerRepositoryInterface          $organizerRepository,
+        private readonly AccountUserAssociationService         $accountUserAssociationService,
+        private readonly CreateDefaultOrganizerSettingsService $organizerSettingsService,
+        private readonly Repository                            $config,
+        private readonly LoggerInterface                       $logger,
+    ) {}
+
+    /**
+     * @param array<int, array{slug?: string, name?: string, roles?: array}> $groups
+     *
+     * @return array<string, int> slug => account id
+     */
+    public function provision(UserDomainObject $user, array $groups): array
+    {
+        $workspaces = [];
+
+        foreach ($groups as $group) {
+            $slug = trim((string) ($group['slug'] ?? ''));
+            $name = trim((string) ($group['name'] ?? ''));
+
+            if ($slug === '' || $name === '') {
+                continue;
+            }
+
+            try {
+                $workspaces[$slug] = $this->provisionGroup(
+                    user: $user,
+                    slug: $slug,
+                    name: $name,
+                    roles: array_map('strval', (array) ($group['roles'] ?? [])),
+                );
+            } catch (Throwable $e) {
+                $this->logger->error('Coop workspace provisioning failed', [
+                    'slug' => $slug,
+                    'error' => $e->getMessage(),
+                ]);
+            }
+        }
+
+        return $workspaces;
+    }
+
+    public function groupRef(string $slug): string
+    {
+        return 'coop:'.$slug;
+    }
+
+    private function provisionGroup(UserDomainObject $user, string $slug, string $name, array $roles): int
+    {
+        $account = Account::query()->where('external_ref', $this->groupRef($slug))->first();
+
+        if ($account === null) {
+            $account = $this->createGroupAccount($name, $slug);
+
+            $this->logger->info('Coop workspace created', [
+                'slug' => $slug,
+                'account_id' => $account->id,
+            ]);
+        } elseif ($account->name !== $name) {
+            // coop is the source of truth: a group rename converges on next sign-in
+            $account->name = $name;
+            $account->save();
+        }
+
+        $this->associate($user, $account, $slug, $roles);
+        $this->ensureOrganizer($account, $name, $slug);
+
+        return (int) $account->id;
+    }
+
+    private function createGroupAccount(string $name, string $slug): Account
+    {
+        $configurationId = AccountConfiguration::query()->where('is_system_default', true)->value('id');
+
+        if ($configurationId === null) {
+            $this->logger->error('No default account configuration found for a coop workspace');
+        }
+
+        return Account::query()->create([
+            'name' => $name,
+            'email' => $this->groupEmail($slug),
+            'short_id' => IdHelper::shortId(IdHelper::ACCOUNT_PREFIX),
+            'timezone' => $this->config->get('app.default_timezone'),
+            'currency_code' => $this->config->get('app.default_currency_code', 'USD'),
+            'account_configuration_id' => $configurationId,
+            'account_messaging_tier_id' => $this->config->get('app.is_hi_events') ? 1 : 3,
+            'account_verified_at' => now()->toDateTimeString(),
+            'external_ref' => $this->groupRef($slug),
+        ]);
+    }
+
+    /**
+     * The member's seat in the group's workspace. Existing rows converge (a
+     * demotion in the group must bite here); a new row is created otherwise.
+     */
+    private function associate(UserDomainObject $user, Account $account, string $slug, array $roles): void
+    {
+        $role = Role::from($this->mapRole($roles));
+        $isOwner = $this->hasRole($roles, 'owner');
+
+        $existing = $this->accountUserRepository->findFirstWhere([
+            'user_id' => $user->getId(),
+            'account_id' => (int) $account->id,
+        ]);
+
+        if ($existing === null) {
+            $this->accountUserAssociationService->associate(
+                user: $user,
+                account: $this->accountDomainObject($account),
+                role: $role,
+                status: UserStatus::ACTIVE,
+                isAccountOwner: $isOwner,
+            );
+
+            return;
+        }
+
+        $this->accountUserRepository->updateFromArray($existing->getId(), [
+            'role' => $role->name,
+            'is_account_owner' => $isOwner,
+            'status' => UserStatus::ACTIVE->name,
+        ]);
+    }
+
+    /**
+     * The association service wants the domain object; hydrate one from the model
+     * (the repository's own hydrator, so no generated code is touched).
+     */
+    private function accountDomainObject(Account $account): \HiEvents\DomainObjects\AccountDomainObject
+    {
+        return \HiEvents\DomainObjects\AccountDomainObject::hydrateFromModel($account);
+    }
+
+    /**
+     * Every group workspace gets a public-facing organizer (its event page), the
+     * same way Formbricks gave every group a workspace. Created only when the
+     * account has none, so a member's own organizers are never overwritten.
+     */
+    private function ensureOrganizer(Account $account, string $name, string $slug): void
+    {
+        if (Organizer::query()->where('account_id', $account->id)->exists()) {
+            return;
+        }
+
+        $organizer = $this->organizerRepository->create([
+            'name' => $name,
+            'email' => $this->groupEmail($slug),
+            'account_id' => (int) $account->id,
+            'timezone' => $account->timezone ?: $this->config->get('app.default_timezone'),
+            'currency' => $account->currency_code,
+            'status' => OrganizerStatus::LIVE->name,
+        ]);
+
+        $this->organizerSettingsService->createOrganizerSettings($organizer);
+    }
+
+    private function mapRole(array $roles): string
+    {
+        foreach ($roles as $role) {
+            $key = strtolower(trim((string) $role));
+
+            if (isset(self::ROLE_TO_ACCOUNT_ROLE[$key])) {
+                return self::ROLE_TO_ACCOUNT_ROLE[$key];
+            }
+        }
+
+        return self::DEFAULT_ACCOUNT_ROLE;
+    }
+
+    private function hasRole(array $roles, string $role): bool
+    {
+        return in_array(
+            $role,
+            array_map(static fn ($r) => strtolower(trim((string) $r)), $roles),
+            true,
+        );
+    }
+
+    private function groupEmail(string $slug): string
+    {
+        return sprintf('%s@%s', $slug, $this->config->get('app.coop_group_email_domain', 'irl.coop'));
+    }
+}
