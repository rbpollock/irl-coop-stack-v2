@@ -0,0 +1,83 @@
+<?php
+
+declare(strict_types=1);
+
+namespace HiEvents\Http\Actions\Auth;
+
+use HiEvents\DomainObjects\Enums\Role;
+use HiEvents\Models\User;
+use HiEvents\Repository\Interfaces\AccountUserRepositoryInterface;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use PHPOpenSourceSaver\JWTAuth\JWTAuth;
+
+/**
+ * SWITCH WORKSPACE — re-mint the member's session for another account (another
+ * coop group's workspace) and land them on the admin.
+ *
+ * A plain browser navigation (`GET /api/auth/workspace/{account_id}?rd=…`), so the
+ * switcher in the app is an ordinary link: the member must already hold a session
+ * (the `token` cookie — jwt-auth parses it), and the target account must be one
+ * they're actually seated in. The new token carries the `account_id` claim that
+ * `SetAccountContext` resolves, which is exactly what makes the whole admin
+ * (events, users, settings) switch tenants.
+ */
+class WorkspaceSwitchAction extends BaseAuthAction
+{
+    public function __construct(
+        private readonly AccountUserRepositoryInterface $accountUserRepository,
+        private readonly JWTAuth                        $jwtAuth,
+    ) {}
+
+    public function __invoke(Request $request, int $account_id): RedirectResponse
+    {
+        // An expired/absent session is not an error page for a navigation: send the
+        // member to the login screen (which carries the coop door).
+        if (!$this->isUserAuthenticated()) {
+            return redirect('/auth/login');
+        }
+
+        $user = $this->getAuthenticatedUser();
+
+        $membership = $this->accountUserRepository->findFirstWhere([
+            'user_id' => $user->getId(),
+            'account_id' => $account_id,
+        ]);
+
+        // Not their workspace? Behave as if the session were gone rather than
+        // confirming which account ids exist.
+        if ($membership === null) {
+            return redirect('/auth/login');
+        }
+
+        $model = User::query()->find($user->getId());
+
+        $token = $this->jwtAuth
+            ->claims([
+                'account_id' => $account_id,
+                'role' => $membership->getRole() ?? Role::ORGANIZER->value,
+            ])
+            ->fromUser($model);
+
+        $this->accountUserRepository->updateWhere(
+            attributes: ['last_login_at' => now()],
+            where: [
+                'user_id' => $user->getId(),
+                'account_id' => $account_id,
+            ],
+        );
+
+        return redirect($this->safeRedirectTarget((string) $request->query('rd', '')))
+            ->withCookie($this->getAuthCookie($token));
+    }
+
+    /** Only ever bounce back inside this app (no open redirect). */
+    private function safeRedirectTarget(string $rd): string
+    {
+        if ($rd !== '' && str_starts_with($rd, '/') && !str_starts_with($rd, '//')) {
+            return $rd;
+        }
+
+        return '/manage/events';
+    }
+}
