+<?php
+
+declare(strict_types=1);
+
+namespace HiEvents\Http\Actions\Auth;
+
+use HiEvents\DomainObjects\Enums\Role;
+use HiEvents\Models\Account;
+use HiEvents\Models\User;
+use HiEvents\Repository\Interfaces\AccountUserRepositoryInterface;
+use Illuminate\Http\JsonResponse;
+
+/**
+ * The member's WORKSPACES — one Hi.Events account per coop group they are seated
+ * in, plus their own (their 1-of-1 group, `personal:user:<id>`).
+ *
+ * The in-app switcher renders this list; selecting one navigates to
+ * `GET /api/auth/workspace/{account_id}`, which re-mints the session for that
+ * account and lands on the admin. Reads go through the Eloquent model because
+ * `accounts.external_ref` is an irl.coop column (deliberately not in the generated
+ * DomainObjects).
+ */
+class ListWorkspacesAction extends BaseAuthAction
+{
+    public function __invoke(): JsonResponse
+    {
+        $user = $this->getAuthenticatedUser();
+        $currentAccountId = $this->getAuthenticatedAccountId();
+
+        $rows = Account::query()
+            ->join('account_users', 'account_users.account_id', '=', 'accounts.id')
+            ->where('account_users.user_id', $user->getId())
+            ->whereNull('account_users.deleted_at')
+            ->whereNull('accounts.deleted_at')
+            // the member's own workspace first, then the groups they're seated in
+            ->orderByRaw("CASE WHEN accounts.external_ref LIKE 'personal:%' THEN 0 ELSE 1 END")
+            ->orderBy('accounts.name')
+            ->get([
+                'accounts.id as id',
+                'accounts.name as name',
+                'accounts.external_ref as external_ref',
+                'account_users.role as role',
+            ]);
+
+        $workspaces = $rows->map(function ($row) use ($currentAccountId) {
+            $externalRef = (string) $row->external_ref;
+            $isGroup = str_starts_with($externalRef, 'coop:');
+
+            return [
+                'id' => (int) $row->id,
+                'name' => $row->name,
+                'kind' => $isGroup ? 'group' : 'personal',
+                'group_slug' => $isGroup ? substr($externalRef, strlen('coop:')) : null,
+                'role' => $row->role ?? Role::ORGANIZER->value,
+                'is_current' => (int) $row->id === $currentAccountId,
+            ];
+        });
+
+        return $this->jsonResponse(['data' => $workspaces]);
+    }
+}
