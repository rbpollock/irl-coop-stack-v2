+<?php
+
+declare(strict_types=1);
+
+namespace HiEvents\Console\Commands;
+
+use HiEvents\Models\Event;
+use HiEvents\Services\Domain\Coop\CoopEventBusWebhookProvisioner;
+use Illuminate\Console\Command;
+
+/**
+ * Reconcile the coop event-bus webhooks (see CoopEventBusWebhookProvisioner):
+ * run at container start so every existing ticketing event has its webhook, and
+ * safe to run by hand at any time. A no-op when COOP_EVENT_BUS_URL is unset.
+ */
+class CoopEventBusSyncCommand extends Command
+{
+    protected $signature = 'coop:event-bus:sync';
+
+    protected $description = 'Ensure every ticketing event has its webhook into the coop event bus';
+
+    public function handle(CoopEventBusWebhookProvisioner $provisioner): int
+    {
+        if (!$provisioner->enabled()) {
+            $this->info('Coop event bus not configured (COOP_EVENT_BUS_URL unset) — nothing to do.');
+
+            return self::SUCCESS;
+        }
+
+        $provisioned = 0;
+
+        Event::query()->whereNull('deleted_at')->chunkById(200, function ($events) use ($provisioner, &$provisioned) {
+            foreach ($events as $event) {
+                if ($provisioner->ensureForEvent($event) !== null) {
+                    $provisioned++;
+                }
+            }
+        });
+
+        $this->info("Coop event-bus webhooks reconciled for {$provisioned} event(s).");
+
+        return self::SUCCESS;
+    }
+}
diff --git a/backend/app/Http/Actions/Auth/GateSsoAction.php b/backend/app/Http/Actions/Auth/GateSsoAction.php
new file mode 100644
index 00000000..acf0b64c
--- /dev/null
+++ b/backend/app/Http/Actions/Auth/GateSsoAction.php
@@ -0,0 +1,379 @@
+<?php
+
+declare(strict_types=1);
+
+namespace HiEvents\Http\Actions\Auth;
+
+use HiEvents\DomainObjects\AccountUserDomainObject;
+use HiEvents\DomainObjects\Enums\Role;
+use HiEvents\DomainObjects\UserDomainObject;
+use HiEvents\Http\ResponseCodes;
+use HiEvents\Models\Account;
+use HiEvents\Models\User;
+use HiEvents\Repository\Interfaces\AccountUserRepositoryInterface;
+use HiEvents\Services\Application\Handlers\Account\CreateAccountHandler;
+use HiEvents\Services\Application\Handlers\Account\DTO\CreateAccountDTO;
+use HiEvents\Services\Application\Handlers\Account\Exceptions\AccountConfigurationDoesNotExist;
+use HiEvents\Services\Application\Handlers\Account\Exceptions\AccountRegistrationDisabledException;
+use HiEvents\Services\Domain\Coop\CoopWorkspaceProvisioner;
+use Illuminate\Config\Repository;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Str;
+use PHPOpenSourceSaver\JWTAuth\JWTAuth;
+use Psr\Log\LoggerInterface;
+use Throwable;
+
+/**
+ * irl.coop Gate SSO — exchange the identity forwarded by the oauth2-proxy fleet
+ * gate (`x-forwarded-email` + the coop `groups` claim as `x-forwarded-groups`) for
+ * a Hi.Events session.
+ *
+ * The gate in front of https://events.<domain>/manage/* authenticates the member
+ * against coop-api (the fleet OIDC issuer; the coop_session cookie makes it
+ * instant) and forwards their canonical address plus their coop group seats. The
+ * frontend SSR (frontend/server.js) sees those headers on a gated document request
+ * and calls this endpoint server-to-server to mint the Hi.Events JWT, then sets it
+ * as the `token` cookie.
+ *
+ * GROUP WORKSPACES — one Hi.Events account per coop group the member is seated in
+ * (see CoopWorkspaceProvisioner), plus their own (their 1-of-1 group). Which one
+ * the session lands in is decided here:
+ *   - `?group=<slug>`   the workspace the caller asked for (dashboard deep-links)
+ *   - `?account_id=<id>` an account the member is actually seated in
+ *   - otherwise        their own workspace
+ * and switching later is `GET /api/auth/workspace/{account_id}`.
+ *
+ * TRUST BOUNDARY — this endpoint mints a session from headers, so it must never be
+ * usable from the public internet:
+ *   1. the caller must present the derived shared secret (COOP_GATE_SSO_SECRET,
+ *      only ever held by the SSR process) — hash_equals compared, and
+ *   2. the caller must be loopback (the SSR talks to nginx on 127.0.0.1; every
+ *      public request arrives via traefik/the gate with a non-loopback peer).
+ * Failing either check returns 403 and logs.
+ */
+class GateSsoAction extends BaseAuthAction
+{
+    public function __construct(
+        private readonly JWTAuth                        $jwtAuth,
+        private readonly AccountUserRepositoryInterface $accountUserRepository,
+        private readonly CreateAccountHandler           $createAccountHandler,
+        private readonly CoopWorkspaceProvisioner       $workspaceProvisioner,
+        private readonly Repository                     $config,
+        private readonly LoggerInterface                $logger,
+    ) {}
+
+    public function __invoke(Request $request): JsonResponse
+    {
+        if (!$this->gateSsoEnabled()) {
+            return $this->errorResponse(
+                message: __('Gate SSO is not enabled on this instance'),
+                statusCode: ResponseCodes::HTTP_FORBIDDEN,
+            );
+        }
+
+        if (!$this->isTrustedCaller($request)) {
+            $this->logger->warning('Rejected a gate SSO mint from an untrusted caller', [
+                'remote_addr' => $request->server('REMOTE_ADDR'),
+                'ip' => $request->getClientIp(),
+            ]);
+
+            return $this->errorResponse(
+                message: __('Untrusted caller'),
+                statusCode: ResponseCodes::HTTP_FORBIDDEN,
+            );
+        }
+
+        $email = strtolower(trim((string) $request->header($this->emailHeader(), '')));
+
+        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
+            return $this->errorResponse(
+                message: __('A valid member email was not forwarded by the gate'),
+                statusCode: ResponseCodes::HTTP_UNPROCESSABLE_ENTITY,
+            );
+        }
+
+        try {
+            $user = $this->ensureUser($email);
+            $personalAccountId = $this->ensurePersonalAccount($user);
+            $workspaces = $this->workspaceProvisioner->provision(
+                user: UserDomainObject::hydrateFromModel($user),
+                groups: $this->forwardedGroups($request),
+            );
+        } catch (AccountRegistrationDisabledException) {
+            return $this->errorResponse(
+                message: __('Account creation is disabled on this instance'),
+                statusCode: ResponseCodes::HTTP_FORBIDDEN,
+            );
+        } catch (AccountConfigurationDoesNotExist $e) {
+            $this->logger->error('Gate SSO could not provision an account: '.$e->getMessage());
+
+            return $this->errorResponse(
+                message: __('No default account configuration available'),
+                statusCode: ResponseCodes::HTTP_INTERNAL_SERVER_ERROR,
+            );
+        } catch (Throwable $e) {
+            $this->logger->error('Gate SSO provisioning failed', [
+                'email' => $email,
+                'error' => $e->getMessage(),
+            ]);
+
+            return $this->errorResponse(
+                message: __('Could not provision a session for the gate identity'),
+                statusCode: ResponseCodes::HTTP_INTERNAL_SERVER_ERROR,
+            );
+        }
+
+        $accountId = $this->selectAccount($request, (int) $user->id, $personalAccountId, $workspaces);
+        $role = $this->roleFor((int) $user->id, $accountId);
+
+        $token = $this->jwtAuth
+            ->claims([
+                'account_id' => $accountId,
+                'role' => $role->value,
+            ])
+            ->fromUser($user);
+
+        $this->accountUserRepository->updateWhere(
+            attributes: ['last_login_at' => now()],
+            where: [
+                'user_id' => $user->id,
+                'account_id' => $accountId,
+            ],
+        );
+
+        return $this->addTokenToResponse(
+            response: $this->jsonResponse([
+                'message' => __('Gate SSO session issued'),
+                'data' => [
+                    'token' => $token,
+                    'token_type' => 'bearer',
+                    'expires_in' => auth()->factory()->getTTL() * 60,
+                    'account_id' => $accountId,
+                    'role' => $role->value,
+                    'email' => $email,
+                    // slug => account id, so the caller can deep-link a group
+                    'workspaces' => $workspaces,
+                ],
+            ]),
+            token: $token,
+        );
+    }
+
+    /**
+     * The member's user row, signing them up on first sight through the same
+     * handler the native sign-up used (default account configuration, messaging
+     * tier, admin owner association). The fleet gate asserted the identity, so a
+     * closed native signup must not block provisioning.
+     */
+    private function ensureUser(string $email): User
+    {
+        $user = User::query()->where('email', $email)->first();
+
+        if ($user !== null) {
+            return $user;
+        }
+
+        $this->logger->info('Gate SSO provisioning a member', ['email' => $email]);
+
+        $account = $this->createAccountHandler->handle(
+            accountData: new CreateAccountDTO(
+                email: $email,
+                // Gate-authenticated members never see this password — the fleet
+                // identity is the credential. The native form stays usable for
+                // accounts that already have one (invites, local admins).
+                password: Str::password(32),
+                first_name: Str::before($email, '@'),
+                locale: 'en',
+            ),
+            bypassRegistrationCheck: true,
+        );
+
+        $user = User::query()->where('email', $email)->first();
+
+        if ($user === null) {
+            throw new \RuntimeException('Gate SSO could not resolve the provisioned member');
+        }
+
+        // Claim the freshly created account as their OWN workspace.
+        $this->markAsPersonal($account->getId(), (int) $user->id);
+
+        return $user;
+    }
+
+    /**
+     * The member's own workspace (their 1-of-1 group), keyed `personal:user:<id>`.
+     * A member who signed up before group workspaces existed has an owner account
+     * with no ref — that one is adopted rather than duplicated, so their existing
+     * events stay put.
+     */
+    private function ensurePersonalAccount(User $user): int
+    {
+        $account = Account::query()
+            ->where('external_ref', $this->personalRef((int) $user->id))
+            ->first();
+
+        if ($account !== null) {
+            return (int) $account->id;
+        }
+
+        $owned = $this->accountUserRepository->findFirstWhere([
+            'user_id' => $user->id,
+            'is_account_owner' => true,
+        ]);
+
+        if ($owned !== null) {
+            $legacy = Account::query()->find($owned->getAccountId());
+
+            if ($legacy !== null && trim((string) $legacy->external_ref) === '') {
+                $this->markAsPersonal((int) $legacy->id, (int) $user->id);
+
+                return (int) $legacy->id;
+            }
+        }
+
+        $created = $this->createAccountHandler->handle(
+            accountData: new CreateAccountDTO(
+                email: strtolower((string) $user->email),
+                password: Str::password(32),
+                first_name: Str::before((string) $user->email, '@'),
+                locale: 'en',
+            ),
+            bypassRegistrationCheck: true,
+        );
+
+        $this->markAsPersonal($created->getId(), (int) $user->id);
+
+        return $created->getId();
+    }
+
+    private function markAsPersonal(int $accountId, int $userId): void
+    {
+        $account = Account::query()->find($accountId);
+
+        if ($account === null || trim((string) $account->external_ref) !== '') {
+            return;
+        }
+
+        $account->external_ref = $this->personalRef($userId);
+        $account->save();
+    }
+
+    private function personalRef(int $userId): string
+    {
+        return 'personal:user:'.$userId;
+    }
+
+    /**
+     * The coop `groups` claim — a JSON STRING minted by coop-api and forwarded by
+     * the gate. Malformed input is logged and ignored: a claim problem must never
+     * cost a member their session.
+     *
+     * @return array<int, array{slug?: string, name?: string, roles?: array}>
+     */
+    private function forwardedGroups(Request $request): array
+    {
+        $raw = (string) $request->header(
+            (string) $this->config->get('app.coop_gate_sso_groups_header', 'x-forwarded-groups'),
+            '',
+        );
+
+        if (trim($raw) === '') {
+            return [];
+        }
+
+        $decoded = json_decode($raw, true);
+
+        if (!is_array($decoded)) {
+            $this->logger->warning('Gate SSO ignored a malformed coop groups claim', [
+                'length' => strlen($raw),
+            ]);
+
+            return [];
+        }
+
+        return $decoded;
+    }
+
+    /**
+     * Which workspace this session lands in. An unknown `group` slug falls back to
+     * the member's own workspace rather than failing the sign-in.
+     *
+     * @param array<string, int> $workspaces
+     */
+    private function selectAccount(Request $request, int $userId, int $personalAccountId, array $workspaces): int
+    {
+        $slug = trim((string) $request->query('group', ''));
+
+        if ($slug !== '' && isset($workspaces[$slug])) {
+            return (int) $workspaces[$slug];
+        }
+
+        $requested = (int) $request->query('account_id', 0);
+
+        if ($requested > 0
+            && $requested !== $personalAccountId
+            && $this->membership($userId, $requested) !== null
+        ) {
+            return $requested;
+        }
+
+        if ($requested > 0 && $requested === $personalAccountId) {
+            return $requested;
+        }
+
+        return $personalAccountId;
+    }
+
+    private function membership(int $userId, int $accountId): ?AccountUserDomainObject
+    {
+        /** @var AccountUserDomainObject|null $membership */
+        $membership = $this->accountUserRepository->findFirstWhere([
+            'user_id' => $userId,
+            'account_id' => $accountId,
+        ]);
+
+        return $membership;
+    }
+
+    private function roleFor(int $userId, int $accountId): Role
+    {
+        $membership = $this->membership($userId, $accountId);
+
+        if ($membership === null || $membership->getRole() === null) {
+            return Role::ADMIN;
+        }
+
+        try {
+            return Role::from($membership->getRole());
+        } catch (Throwable) {
+            return Role::ADMIN;
+        }
+    }
+
+    private function gateSsoEnabled(): bool
+    {
+        return in_array(
+            strtolower((string) $this->config->get('app.coop_gate_sso_enabled', 'false')),
+            ['true', '1'],
+            true,
+        );
+    }
+
+    private function emailHeader(): string
+    {
+        return (string) $this->config->get('app.coop_gate_sso_email_header', 'x-forwarded-email');
+    }
+
+    private function isTrustedCaller(Request $request): bool
+    {
+        $expected = (string) $this->config->get('app.coop_gate_sso_secret', '');
+        $presented = (string) $request->header('X-Coop-Gate-Secret', '');
+
+        if ($expected === '' || $presented === '' || !hash_equals($expected, $presented)) {
+            return false;
+        }
+
+        return in_array((string) $request->server('REMOTE_ADDR'), ['127.0.0.1', '::1'], true);
+    }
+}
