diff --git a/frontend/src/hooks/useWorkspaces.ts b/frontend/src/hooks/useWorkspaces.ts
new file mode 100644
index 00000000..f9dd80fe
--- /dev/null
+++ b/frontend/src/hooks/useWorkspaces.ts
@@ -0,0 +1,38 @@
+import {useQuery} from "@tanstack/react-query";
+import {api} from "../api/client.ts";
+
+/**
+ * irl.coop workspaces — the member's session can be scoped to one Hi.Events
+ * account at a time. They always have their own (their 1-of-1 group) and one per
+ * coop group they're seated in; `GET /api/auth/workspaces` is served by the coop
+ * patch (one account per coop group, keyed `external_ref = coop:<slug>`).
+ *
+ * Switching is a plain navigation to `/api/auth/workspace/<id>` — the backend
+ * re-mints the session for that account and redirects into the admin, so there is
+ * no client-side token juggling here.
+ */
+export type Workspace = {
+    id: number;
+    name: string;
+    kind: 'group' | 'personal';
+    group_slug: string | null;
+    role: string | null;
+    is_current: boolean;
+};
+
+export const useWorkspaces = () => {
+    return useQuery<Workspace[]>({
+        queryKey: ['workspaces'],
+        queryFn: async () => {
+            const {data} = await api.get<{ data: Workspace[] }>('auth/workspaces');
+            return data.data;
+        },
+        retry: false,
+        staleTime: 60 * 1000,
+    });
+};
+
+export const switchWorkspace = (id: number, redirectTo?: string) => {
+    const suffix = redirectTo ? `?rd=${encodeURIComponent(redirectTo)}` : '';
+    window.location.href = `/api/auth/workspace/${id}${suffix}`;
+};
