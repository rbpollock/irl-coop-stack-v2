# ── Dependencies ────────────────────────────────────────────────
node_modules/

# ── Secrets / credentials — never commit ────────────────────────
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.p12
*.jks

# TLS state + ACME accounts (infra/instances/dev/certs/ — private keys)
infra/instances/dev/certs/

# ── Build / generated output ────────────────────────────────────
__pycache__/
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
apps/web/irl-dashboard/.next/
apps/web/starter-kit/.next/
dist/
build/
# ...but infra/build/ is the declarative pipeline source (generator.py,
# custom-image Dockerfiles) — never ignore it
!infra/build/
*.tsbuildinfo

# Generated deployment output (derived from infra/instances + generator.py)
infra/out/

# ── Runtime data ────────────────────────────────────────────────
infra/compose/storage/data/
apps/coop-api/data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ── Logs ────────────────────────────────────────────────────────
*.log
certs/renew.log

# ── Editor / OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Agent / tooling ─────────────────────────────────────────────
.jspace/

# Matrix stack runtime configs (homeserver.yaml, coturn secret, client configs)
infra/instances/dev/config/matrix/
# element-web config.json is a tracked declarative default (theme/SSO — no secrets)
infra/instances/dev/config/element-web/*
!infra/instances/dev/config/element-web/config.json
infra/instances/dev/config/element-call/
infra/instances/dev/etc/coturn/
# test-runner output (vitest/jest artifacts, not repo content)
test-results/

# ── libtool object/archive output (lab-mgcp FreeSWITCH module build) ──
.libs/
*.lo
*.la
*.lai
