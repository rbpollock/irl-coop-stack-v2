    "dev:api": "npm run dev --workspace=apps/coop-api"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "js-yaml": "^5.2.2"
  }
}
