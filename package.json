{
  "name": "irl-coop-stack-v2",
  "version": "1.0.0",
  "private": true,
  "description": "irl.coop Community OS Monorepo v2",
  "workspaces": [
    "apps/*",
    "contracts"
  ],
  "scripts": {
    "test:contracts": "npm run test --workspace=contracts",
    "compile:contracts": "npm run compile --workspace=contracts",
